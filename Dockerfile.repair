FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/workspaces/.home

RUN apt-get update \
    && apt-get install -y --no-install-recommends bubblewrap socat \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 repair

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY repair_worker ./repair_worker
COPY repair_targets ./repair_targets
RUN mkdir -p /workspaces/.home /workspaces/jobs \
    && chown -R repair:repair /workspaces

USER repair
EXPOSE 8090
CMD ["uvicorn", "repair_worker.main:app", "--host", "0.0.0.0", "--port", "8090"]
