FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_VERSION=v1-stable \
    STARTUP_FAULT=none

WORKDIR /app
RUN pip install --no-cache-dir "fastapi>=0.115,<1.0" "uvicorn[standard]>=0.30,<1.0"
COPY demo_service ./demo_service

EXPOSE 8081
HEALTHCHECK --interval=3s --timeout=2s --start-period=3s --retries=10 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8081/health', timeout=1)"

CMD ["uvicorn", "demo_service.main:app", "--host", "0.0.0.0", "--port", "8081"]
