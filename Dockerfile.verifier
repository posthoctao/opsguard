FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp

RUN useradd --create-home --uid 10001 verifier
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY repair_verifier ./repair_verifier
RUN mkdir -p /workspaces/jobs && chown -R verifier:verifier /workspaces

USER verifier
EXPOSE 8100
CMD ["uvicorn", "repair_verifier.main:app", "--host", "0.0.0.0", "--port", "8100"]
