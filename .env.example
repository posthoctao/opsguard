APP_NAME=智能故障诊断与安全修复后端
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/incidents.db
DEDUPE_WINDOW_SECONDS=300

# 本地无 Key 演示请使用 rules；如需 Claude Agent SDK 诊断，请设置为 claude。
AI_PROVIDER=rules
AI_FALLBACK_TO_RULES=true
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TURNS=3
CLAUDE_TIMEOUT_SECONDS=90
# ANTHROPIC_API_KEY=

# memory：用于测试和快速本地开发的确定性进程内 Runtime。
# http：通过 HTTP 管理接口控制独立演示服务。
# docker：通过 Docker SDK 执行真实容器检查、重启和重建。
RUNTIME_BACKEND=memory
DEMO_SERVICE_URL=http://demo-service:8081
RUNTIME_TIMEOUT_SECONDS=10

# Docker Runtime 的所有目标值由服务端固定配置，绝不接受模型输出。
DOCKER_CONTAINER_NAME=incident-ai-demo-service
DOCKER_DEMO_SERVICE_URL=http://incident-ai-demo-service:8081
DOCKER_NETWORK_NAME=incident-ai-network
DOCKER_NETWORK_ALIAS=demo-service
DOCKER_DEMO_IMAGE=incident-ai-demo:local
DOCKER_DEMO_INTERNAL_PORT=8081
DOCKER_DEMO_HOST_PORT=8081
DOCKER_MANAGED_LABEL_KEY=com.incident-ai.managed
DOCKER_MANAGED_LABEL_VALUE=true
DOCKER_STABLE_VERSION=v1-stable
DOCKER_BUGGY_VERSION=v2-buggy
DOCKER_WAIT_TIMEOUT_SECONDS=30
DOCKER_LOGS_TAIL=100

AUTO_PROCESS_ALERTS=true
MAX_REMEDIATION_ATTEMPTS=1

# 隔离式代码修复 Worker。Worker 永远不会获得 Docker 或 GitHub 凭证。
REPAIR_WORKER_URL=http://repair-worker:8090
REPAIR_WORKER_TIMEOUT_SECONDS=180
REPAIR_SOURCE_PROFILE=demo-buffer-bug
REPAIR_AGENT_PROVIDER=rules
REPAIR_CLAUDE_MODEL=claude-sonnet-4-6
REPAIR_CLAUDE_MAX_TURNS=20
REPAIR_CLAUDE_TIMEOUT_SECONDS=180
REPAIR_CLAUDE_MAX_BUDGET_USD=2.0
REPAIR_VERIFIER_URL=http://repair-verifier:8100
REPAIR_TEST_TIMEOUT_SECONDS=60

# 可选的后端 PR 发布配置。Token 不会发送给 Claude 或 Repair Worker。
GITHUB_PR_ENABLED=false
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=owner/repository
GITHUB_BASE_BRANCH=main
GITHUB_API_URL=https://api.github.com
